# Copy to .env.local and fill in. Never commit real values.

# Public site URL (optional; defaults to https://bettercorella.vercel.app)
NEXT_PUBLIC_SITE_URL=

# OpenWeather API key (free tier, Current Weather API). Server-only: used by /api/weather.
# Without it the home page simply hides the weather.
OPENWEATHER_API_KEY=
