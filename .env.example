# Copy to .env.local and fill in. Never commit real values.

# Public site URL (optional; defaults to https://bettercorella.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Discord webhook for the "Suggest a spot or event" form (/api/suggestions). Server-only.
# Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy Webhook URL.
# Without it the form shows a "could not send" message with a GitHub issue fallback.
DISCORD_SUGGESTIONS_WEBHOOK_URL=

# Discord webhook for the "Register your business" form (/api/business-listings). Server-only.
# Optional: when empty, business listings go to DISCORD_SUGGESTIONS_WEBHOOK_URL instead.
DISCORD_BUSINESS_WEBHOOK_URL=
