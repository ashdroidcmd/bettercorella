{
  "name": "bettercorella",
  "version": "1.0.0",
  "private": true,
  "description": "BetterCorella: an independent civic guide to the services, officials, barangays, budgets and public records of the Municipality of Corella, Bohol",
  "keywords": [
    "bettergovph",
    "civic-tech",
    "corella",
    "bohol",
    "lgu",
    "open-data",
    "transparency"
  ],
  "homepage": "https://bettercorella.vercel.app",
  "bugs": {
    "url": "https://github.com/ashdroidcmd/bettercorella/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashdroidcmd/bettercorella.git"
  },
  "license": "ISC",
  "author": "BetterCorella Contributors",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "test:e2e:ui": "playwright test --project=chromium --ui",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:e2e:report": "playwright show-report",
    "prebuild": "node scripts/copy-maplibre-worker.mjs && node scripts/data-freshness.ts",
    "start": "next start",
    "predev": "node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "motion": "^14.5.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@serwist/turbopack": "^9.5.13",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.33",
    "serwist": "^9.5.13",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
